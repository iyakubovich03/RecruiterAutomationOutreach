GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Search API. Public search pages (DuckDuckGo, Bing) now block or ignore
# automated site:linkedin.com/in/ queries, so recruiter discovery needs a key.
# Recommended: Serper (https://serper.dev) — whole-web Google results, free
# starter credits, no card. Sign in, open API Keys, paste the key here.
SERPER_API_KEY=
# Or SerpApi (https://serpapi.com, 100 free searches/month).
SERPAPI_KEY=
# Google Custom Search JSON API is closed to new customers (403 "This project
# does not have the access") and shuts down 2027-01-01. Only fill these in if
# your project already had access.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Job-search wording, ranking, and the default email live in search.config.json (not here).
