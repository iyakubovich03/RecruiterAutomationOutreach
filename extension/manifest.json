{
  "manifest_version": 3,
  "name": "Recruiter Outreach",
  "version": "0.1.0",
  "description": "After you apply to a job, find the company's recruiters through your local Recruiter Outreach app and send your default email with your resume.",
  "action": { "default_popup": "popup.html", "default_title": "Recruiter Outreach", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [{ "matches": ["https://*/*"], "js": ["detect.js", "content.js"], "run_at": "document_idle" }]
}
